# Normalize line endings for all text files
* text=auto

# Force LF for Capacitor auto-generated Gradle files (prevent CRLF noise on Windows)
frontend/android/capacitor.settings.gradle text eol=lf
frontend/android/app/capacitor.build.gradle text eol=lf

# Force LF for all other Gradle/Android files
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.xml text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.json text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files - no line ending conversion
*.apk binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.keystore binary
